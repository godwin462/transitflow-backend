generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @unique @default(cuid())
  email           String     @unique
  firstName       String?
  lastName        String?
  phone           String?
  active          Boolean    @default(true)
  activeRole      Role?
  isEmailVerified Boolean    @default(false)
  username        String     @unique
  gender          Gender?
  dob             DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  address         Address?
  auth            Auth?
  token           AuthToken?
  locations       Location[]
  otp             Otp?
  shifts          Shift[]
  trips           Trip[]
  roles           UserRole[]
  vehicle         Vehicle?
}

model Otp {
  id         String    @id @default(cuid())
  userId     String    @unique
  otp        String
  attempts   Int       @default(0)
  retryAfter DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Auth {
  id         String  @id @default(cuid())
  userId     String  @unique
  isVerified Boolean @default(false)
  password   String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id     String @id @default(cuid())
  userId String @unique
  token  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id     String @id @default(cuid())
  userId String @unique
  street String
  city   String
  state  String
  zip    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VehicleImage {
  id        String   @id @default(cuid())
  secureUrl String
  publicId  String
  vehicleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id           String          @id @default(cuid())
  userId       String          @unique
  make         String
  model        String
  year         Int
  color        String
  licensePlate String          @unique
  capacity     Int
  size         VehicleSize
  vin          String          @unique
  category     VehicleCategory
  isPublic     Boolean         @default(false)
  isVerified   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  shifts       Shift[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  images       VehicleImage[]
}

model Location {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  address   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Route {
  id             String                  @id @default(cuid())
  name           String?
  geometry       Unsupported("geometry") // LineString
  polylineString String?
  lengthMeters   Float
  createdAt      DateTime                @default(now())

  shifts Shift[]

  @@index([geometry], type: Gist)
}

model Shift {
  id              String                  @id @default(cuid())
  name            String
  originName      String
  destinationName String
  startTime       DateTime
  endTime         DateTime?
  status          ShiftStatus             @default(online)
  driverId        String
  vehicleId       String
  routeId         String
  origin          Unsupported("geometry") // Point
  destination     Unsupported("geometry") // Point
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  driver          User                    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle         Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route           Route                   @relation(fields: [routeId], references: [id])
  matches         RideMatch[]
  trips           Trip[]
}

model Trip {
  id               String                  @id @default(cuid())
  name             String
  originName       String // Name
  destinationName  String // Name
  passengerId      String
  mode             TransportMode           @default(public)
  status           TripStatus              @default(pending)
  shiftId          String?
  createdAt        DateTime                @default(now())
  vehicleType      TripVehicleCategory?
  updatedAt        DateTime                @updatedAt
  polylineString   String
  originPoint      Unsupported("geometry") // Point
  destinationPoint Unsupported("geometry") // Point

  maxWalkMeters Float
  earliestStart DateTime?
  latestStart   DateTime?
  matches       RideMatch[]

  passenger User   @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  shift     Shift? @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([originPoint], type: Gist)
  @@index([destinationPoint], type: Gist)
}

model RideMatch {
  id String @id @default(cuid())

  tripId  String
  shiftId String

  pickupPoint  Unsupported("geometry") // Point on route
  dropoffPoint Unsupported("geometry") // Point on route

  pickupFraction  Float // 0.0 → 1.0
  dropoffFraction Float

  pickupWalkMeters  Float
  dropoffWalkMeters Float

  estimatedPickupTime  DateTime
  estimatedDropoffTime DateTime

  status RideMatchStatus @default(proposed)
  score  Float

  createdAt DateTime @default(now())

  trip  Trip  @relation(fields: [tripId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([pickupPoint], type: Gist)
  @@index([shiftId, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  admin
  passenger
  driver
}

enum Gender {
  male
  female
}

enum VehicleCategory {
  car
  truck
  motorcycle
  danfo
  ferry
  train
  brt
  tricycle
  bike
  suv
  sedan
}

enum TripVehicleCategory {
  all
  car
  truck
  motorcycle
  danfo
  ferry
  train
  brt
  tricycle
  bike
  suv
  sedan
}

enum VehicleSize {
  sm
  m
  l
  xl
  xxl
}

enum RideStatus {
  requested
  accepted
  completed
  cancelled
}

enum ShiftStatus {
  online
  offline
  ended
  cancelled
}

enum TransportMode {
  public
  private
}

enum TripStatus {
  searching
  completed // trip
  cancelled
  accepted
  pending
  matched
  started
}

enum RideMatchStatus {
  proposed
  accepted
  declined
  cancelled
}
